<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RanvierIntegrationTest>true</RanvierIntegrationTest>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ranvier.Persistence.Tests/Support.fs" Link="Support.fs" />
    <Compile Include="../Ranvier.Persistence.Tests/StoreConformance.fs" Link="StoreConformance.fs" />
    <Compile Include="../Ranvier.Persistence.Tests/OptimisticStoreConformance.fs" Link="OptimisticStoreConformance.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Main.fs" />
    <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <ProjectReference Include="../../samples/Ranvier.Persistence.Equinox/Ranvier.Persistence.Equinox.fsproj" />
  </ItemGroup>
</Project>
