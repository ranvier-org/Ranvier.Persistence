<Project>
    <Import Project="../Directory.Build.props" />

    <PropertyGroup>
        <FSharpCoreImplicitPackageVersion>8.0.100</FSharpCoreImplicitPackageVersion>
        <FablePackageType>library</FablePackageType>
        <NuspecOutputPath Condition="'$(NuspecOutputPath)' == ''">$(MSBuildThisFileDirectory)../bin/nuspec/$(MSBuildProjectName)/$(Configuration)/</NuspecOutputPath>
    </PropertyGroup>

    <!-- A traced build's creation sites skip frames from an assembly with this marker. The core is matched by
         reference, so its untraced build is unchanged. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Ranvier'">
        <AssemblyMetadata Include="RanvierLibrary" Value="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Package.SDK" Version="1.4.1" PrivateAssets="all"
                          IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
    </ItemGroup>
</Project>
