<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-preview.2</Version>
    <PackageId>Ranvier.Persistence.KurrentDB</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.Persistence.KurrentDB.Traced</PackageId>
    <Description>Small scoped snapshots in KurrentDB for Ranvier, with atomic batches and optional optimistic concurrency.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ranvier.Persistence.KurrentDB.Tests" />
    <Compile Include="SnapshotRetry.fs" />
    <Compile Include="KurrentDBStateStore.fs" />
    <PackageReference Include="KurrentDB.Client" Version="1.4.1" />
    <ProjectReference Include="../../src/Ranvier.Persistence/Ranvier.Persistence.fsproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>
